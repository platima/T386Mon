#include <windows.h>

1 ICON "t386mon.ico"

1 VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0904e4"
        BEGIN
            VALUE "FileDescription", "T386MON: how fast Windows 95 runs on tiny386"
            VALUE "FileVersion", "1.2"
            VALUE "InternalName", "T386MON"
            VALUE "OriginalFilename", "T386MON.EXE"
            VALUE "ProductName", "T386MON"
            VALUE "ProductVersion", "1.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c09, 1252
    END
END
